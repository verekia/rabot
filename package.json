{
  "name": "rabot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless rabot next dev",
    "build": "next build",
    "start": "serve out",
    "postinstall": "next typegen",
    "typecheck": "bun check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
