    "test": "bun test",
    "all": "bun run format:check && bun run lint && bun run typecheck && bun run warden && bun run test"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/bun": "1.4.2",
    "@types/node": "25.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@verekia/warden": "0.0.6",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "1.63.0",
    "portless": "0.13.0",
    "postcss": "8.5.14",
    "serve": "14.2.6",
    "tailwindcss": "4.3.0",
    "typescript": "7.0.2"
  },
